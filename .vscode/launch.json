{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "inputs": [
    {
      "id": "testPort",
      "type": "promptString",
      "description": "测试端口",
      "default": "3000"
    }
  ],
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "启动测试程序",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/test/dist/index.js",
      "args": ["--port", "${input:testPort}"],
      "outFiles": ["${workspaceFolder}/**/*.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "编译并启动测试程序",
      "preLaunchTask": "test-build",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/test/dist/index.js",
      "args": ["--port", "${input:testPort}"],
      "outFiles": ["${workspaceFolder}/**/*.js"]
    }
  ]
}