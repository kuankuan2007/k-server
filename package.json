{
  "name": "@kuankuan/k-server",
  "version": "2.0.0-beta.1",
  "description": "A simple and easy-to-use server framework for Node.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "lint:fix": "eslint src/**/* --fix",
    "lint": "eslint src/**/*",
    "test-build": "rolldown -c rolldown.config.test.ts",
    "test": "pnpm run test-build && node ./test/dist/index.js",
    "format": "prettier --write src/ test/",
    "type-check": "tsc -p test/tsconfig.json"
  },
  "author": "kuankuan",
  "license": "MPL-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.16",
    "typedoc": "^0.28.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@kuankuan/log-control": "^0.2.3"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "server",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kuankuan2007/k-server.git"
  },
  "homepage": "https://github.com/kuankuan2007/k-server",
  "bugs": {
    "url": "https://github.com/kuankuan2007/k-server/issues"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs",
      "default": "./dist/*.mjs"
    }
  },
  "packageManager": "pnpm@12.5.1"
}